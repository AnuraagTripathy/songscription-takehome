# Copy to .env.local and fill in from your Supabase project.
# Dashboard → Project Settings → Data API (URL + anon key)
#           → Project Settings → API Keys (service_role key)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The demo gate. Optional: defaults to songscription123.
DEMO_PASSWORD=songscription123
